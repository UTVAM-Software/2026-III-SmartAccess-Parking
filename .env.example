# Plantilla de referencia. Django no carga este archivo automáticamente.
# Sustituye la clave por una generada localmente; no subas secretos reales.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-locally-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Desarrollo local con SQLite. Para PostgreSQL define también nombre, usuario,
# contraseña, host y puerto proporcionados por quien administra el servidor.
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Opcionales cuando se despliega detrás de HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_HTTPS_PROXY=false
